# NulaLabs Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# ============================================
# REQUIRED: Anthropic API Configuration
# ============================================
# Get your API key from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your_api_key_here

# Optional: Override default model (defaults to claude-sonnet-4-5)
# Other options: claude-3-5-haiku-20241022, claude-opus-4-5
# ANTHROPIC_MODEL=claude-sonnet-4-5

# ============================================
# OPTIONAL: AI Agent Configuration
# ============================================

# Maximum number of AI reasoning steps per conversation turn
# Controls how many sequential tool calls the AI can make before stopping
# - Lower values (10-15): Simple queries, faster responses, lower costs
# - Default (25): Balanced setting for most use cases
# - Higher values (30-50): Complex multi-step workflows, deep analysis
# MAX_AI_STEPS=25

# ============================================
# OPTIONAL: MCP Server Authentication
# ============================================

# SleepyRat Platform Token
# Get token from: https://sleepyrat.ai
SLEEPYRAT_TOKEN=your_sleepyrat_token_here

# Custom MCP Server Tokens
# Add any additional MCP server tokens here
# CUSTOM_SERVER_TOKEN=your_token_here

# ============================================
# OPTIONAL: Server Credentials
# ============================================

# If your MCP servers require username/password authentication
# SERVER_USERNAME=your_username
# SERVER_PASSWORD=your_password

# ============================================
# NOTES
# ============================================
# - Use ${VARIABLE_NAME} in mcp-config.json to reference these variables
# - Tokens are automatically injected at runtime
# - Never share your .env file or commit it to version control
# - Restart the dev server after changing environment variables
